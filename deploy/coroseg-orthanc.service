# Service systemd (installation sans Docker, code dans /root/coroscanner, venv dans .venv) :
#   cp deploy/coroseg-orthanc.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now coroseg-orthanc
#   journalctl -u coroseg-orthanc -f
[Unit]
Description=CoroSeg - segmentation automatique des coroscanners recus par Orthanc
After=network-online.target
Wants=network-online.target

[Service]
User=root
WorkingDirectory=/root/coroscanner
EnvironmentFile=/root/coroscanner/deploy/coroseg.env
Environment=COROSEG_WORK_DIR=/var/lib/coroseg
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/coroscanner/.venv/bin/python -m coroseg_orthanc watch
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
