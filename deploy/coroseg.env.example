# Copier en deploy/coroseg.env et adapter.

# --- Orthanc ---
ORTHANC_URL=http://localhost:8042
ORTHANC_USER=
ORTHANC_PASSWORD=

# --- TotalSegmentator ---
TOTALSEG_LICENSE=aca_XXXXXXXXXXXX
# gpu, gpu:1 ou cpu (CPU : compter 5 à 15 min par examen)
COROSEG_DEVICE=gpu

# --- Déclenchement ---
# auto  : chaque étude reçue (stable) contenant une série CT éligible est traitée
# label : seules les études marquées du label "coroseg" (Orthanc Explorer 2) sont traitées
COROSEG_TRIGGER=auto
COROSEG_LABEL_TODO=coroseg
COROSEG_LABEL_DONE=coroseg-ok
COROSEG_LABEL_ERROR=coroseg-erreur

# --- Choix de la série CT dans l'étude (la plus fine, puis la plus longue) ---
COROSEG_MIN_SLICES=80
COROSEG_MAX_THICKNESS_MM=1.5
# regex (insensibles à la casse) sur SeriesDescription ; vide = pas de filtre
COROSEG_SERIES_INCLUDE=
#COROSEG_SERIES_EXCLUDE=score|calc|topo|scout|bolus|test|mip|mpr|cpr|3d|dose|lung
# regex sur StudyDescription (ex. coro|cardi) pour ne traiter que les coroscanners en mode auto
COROSEG_STUDY_REGEX=

# --- Sorties renvoyées dans l'étude ---
COROSEG_SEND_SEG=true
# fusion : roi (coupes avec coronaires), all, off
COROSEG_FUSION=roi
COROSEG_SEND_CPR=true
COROSEG_SEND_REPORT=true
COROSEG_JPEG=true
COROSEG_WL=300
COROSEG_WW=900
# renvoyer aussi les résultats vers une modalité déclarée dans Orthanc (ex. le PACS)
COROSEG_FORWARD_MODALITY=
COROSEG_KEEP_WORK=true
